"Almese": 1334,
"Alpette": 390,
"Alpignano": 1644,
"Andezeno": 1230,
"Andrate": 499,
"Angrogna": 514,
"Arignano": 1006,
"Avigliana": 1559,
"Azeglio": 362,
"Bairo": 518,
"Balangero": 791,
"Baldissero Canavese": 479,
"Baldissero Torinese": 1226,
"Balme": 777,
"Banchette": 870,
"Barbania": 620,
"Bardonecchia": 3242,
"Barone Canavese": 521,
"Beinasco": 1673,
"Bibiana": 790,
"Bobbio Pellice": 544,
"Bollengo": 646,
"Borgaro Torinese": 1900,
"Borgiallo": 612,
"Borgofranco d'Ivrea": 555,
"Borgomasino": 394,
"Borgone Susa": 756,
"Bosconero": 971,
"Brandizzo": 1474,
"Bricherasio": 1205,
"Brosso": 518,
