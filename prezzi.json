// ═══════════════════════════════════════════
// WIZARD LOGIC
// ═══════════════════════════════════════════
function renderCurrentStep() {
  const step = steps[currentStep];
  const fa = document.getElementById('fieldsArea');

  fa.style.animation = 'none';
  fa.offsetHeight; // reflow
  fa.style.animation = '';

  fa.innerHTML = step.render();

  document.getElementById('stepTitle').textContent = step.title;
  document.getElementById('stepSubtitle').textContent = step.subtitle;
  document.getElementById('stepLabel').textContent = step.title;
  document.getElementById('stepFraction').textContent = `${currentStep+1} / ${steps.length}`;

  const pct = ((currentStep) / (steps.length - 1)) * 100;
  document.getElementById('progressFill').style.width = Math.max(pct, 4) + '%';

  // dots
  const dots = document.getElementById('stepDots');
  dots.innerHTML = '';
  steps.forEach((_,i) => {
    const d = document.createElement('div');
    d.className = 'step-dot' + (i === currentStep ? ' active' : i < currentStep ? ' done' : '');
    dots.appendChild(d);
  });

  document.getElementById('btnPrev').disabled = currentStep === 0;

  const btnNext = document.getElementById('btnNext');
  if (currentStep === steps.length - 1) {
    btnNext.style.display = 'none';
  } else {
    btnNext.style.display = 'inline-flex';
    btnNext.innerHTML = 'Avanti <span class="btn-icon">→</span>';
  }

  // Init location selects if step 0
  if (currentStep === 0) { initLocationSelects(); restoreFields(); }
  else restoreFields();
}

function nextStep() {
  if (currentStep < steps.length - 1) {
    saveCurrentFields();
    currentStep++;
    renderCurrentStep();
    window.scrollTo({top:0,behavior:'smooth'});
  }
}

function prevStep() {
  if (currentStep > 0) {
    saveCurrentFields();
    currentStep--;
    renderCurrentStep();
    window.scrollTo({top:0,behavior:'smooth'});
  }
}

// ═══════════════════════════════════════════
// LOCATION SELECTS
// ═══════════════════════════════════════════
let _comuneIndex = null;
function _normComune(s){ return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,''); }
function buildComuneIndex(){
  if (_comuneIndex) return _comuneIndex;
  const idx = [];
  for (const reg in regioniData){
    for (const prov in regioniData[reg]){
      for (const com in regioniData[reg][prov]){
        idx.push({reg, prov, com, prezzo: regioniData[reg][prov][com], n: _normComune(com)});
      }
    }
  }
  _comuneIndex = idx;
  return idx;
}
function setupComuneSearch(regioneSelect, provinciaSelect, comuneSelect){
  const input = document.getElementById('comuneSearch');
  const box = document.getElementById('comuneSearchResults');
  if (!input || !box) return;
  let active = -1, current = [];
  function close(){ box.classList.remove('open'); box.innerHTML=''; active=-1; current=[]; }
  function pick(item){
    if (!item) return;
    regioneSelect.value = item.reg; regioneSelect.dispatchEvent(new Event('change'));
    provinciaSelect.value = item.prov; provinciaSelect.dispatchEvent(new Event('change'));
    comuneSelect.value = item.com; comuneSelect.dispatchEvent(new Event('change'));
    input.value = item.com;
    close();
  }
  function render(){
    if (!current.length){ box.innerHTML = '<div class="search-empty">Nessun comune trovato</div>'; box.classList.add('open'); return; }
    box.innerHTML = current.map((it,i)=>`
      <div class="search-item${i===active?' active':''}" data-i="${i}" role="option">
        <div class="si-main"><span class="si-c">${it.com}</span><span class="si-loc">${it.prov} · ${it.reg}</span></div>
        <span class="si-pz">${it.prezzo.toLocaleString('it-IT')} €/mq</span>
      </div>`).join('');
    box.classList.add('open');
    box.querySelectorAll('.search-item').forEach(el=>{
      el.addEventListener('mousedown', e=>{ e.preventDefault(); pick(current[+el.dataset.i]); });
    });
  }
  function search(q){
    const nq = _normComune(q.trim());
    if (nq.length < 2){ close(); return; }
    const idx = buildComuneIndex();
    const starts = [], contains = [];
    for (const it of idx){
      const p = it.n.indexOf(nq);
      if (p === 0){ if (starts.length < 8) starts.push(it); }
      else if (p > 0){ if (contains.length < 8) contains.push(it); }
    }
    current = starts.concat(contains).slice(0, 8);
    active = current.length ? 0 : -1;
    render();
  }
  input.addEventListener('input', ()=>search(input.value));
  input.addEventListener('focus', ()=>{ if (input.value.trim().length >= 2) search(input.value); });
  input.addEventListener('keydown', e=>{
    if (!box.classList.contains('open')) return;
    if (e.key === 'ArrowDown'){ e.preventDefault(); active = Math.min(active+1, current.length-1); render(); }
    else if (e.key === 'ArrowUp'){ e.preventDefault(); active = Math.max(active-1, 0); render(); }
    else if (e.key === 'Enter'){ e.preventDefault(); pick(current[active]); }
    else if (e.key === 'Escape'){ close(); }
  });
  document.addEventListener('click', e=>{ if (!e.target.closest('.comune-search-wrap')) close(); });
}
