  const w = window.open('','_blank');
  w.document.open();
  w.document.write(html);
  w.document.close();
  w.onload = () => { w.focus(); w.print(); };
}

// ═══════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════
renderCurrentStep();
</script>
</body>
</html>
