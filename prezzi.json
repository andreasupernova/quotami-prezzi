"Almese": 1324,
"Alpette": 402,
"Alpignano": 1630,
"Andezeno": 1167,
"Andrate": 503,
"Angrogna": 511,
"Arignano": 996,
"Avigliana": 1557,
"Azeglio": 373,
"Bairo": 518,
"Balangero": 816,
"Baldissero Canavese": 450,
"Baldissero Torinese": 1226,
"Balme": 774,
"Banchette": 854,
"Barbania": 649,
"Bardonecchia": 3231,
"Barone Canavese": 501,
"Beinasco": 1671,
"Bibiana": 717,
"Bobbio Pellice": 544,
"Bollengo": 663,
"Borgaro Torinese": 1845,
"Borgiallo": 623,
"Borgofranco d'Ivrea": 594,
"Borgomasino": 406,
"Borgone Susa": 756,
"Bosconero": 998,
"Brandizzo": 1465,
"Bricherasio": 1183,
