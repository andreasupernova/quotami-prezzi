// ═══════════════════════════════════════════
// RENDER HELPERS
// ═══════════════════════════════════════════
function fieldSelect(id, label, options) {
  const opts = options.map(([v,t]) => `<option value="${v}">${t}</option>`).join('');
  return `
    <div class="field-group">
      <label for="${id}">${label}</label>
      <div class="field-control">
        <select id="${id}">${opts}</select>
      </div>
    </div>`;
}

function fieldNumber(id, label, placeholder='', min='') {
  return `
    <div class="field-group">
      <label for="${id}">${label}</label>
      <div class="field-control">
        <input type="number" id="${id}" placeholder="${placeholder}" ${min !== '' ? `min="${min}"` : ''}>
      </div>
    </div>`;
}

function siNo(id, label, defaultNo=true) {
  const opts = defaultNo
    ? [['no','No'],['si','Sì']]
    : [['si','Sì'],['no','No']];
  return fieldSelect(id, label, opts);
}

