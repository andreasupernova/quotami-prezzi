// ═══════════════════════════════════════════
// WIZARD LOGIC
// ═══════════════════════════════════════════
function renderCurrentStep() {
  const step = steps[currentStep];
  const fa = document.getElementById('fieldsArea');

  fa.style.animation = 'none';
  fa.offsetHeight; // reflow
  fa.style.animation = '';

  fa.innerHTML = step.render();

  document.getElementById('stepTitle').textContent = step.title;
  document.getElementById('stepSubtitle').textContent = step.subtitle;
  document.getElementById('stepLabel').textContent = step.title;
  document.getElementById('stepFraction').textContent = `${currentStep+1} / ${steps.length}`;

  const pct = ((currentStep) / (steps.length - 1)) * 100;
  document.getElementById('progressFill').style.width = Math.max(pct, 4) + '%';

  // dots
  const dots = document.getElementById('stepDots');
  dots.innerHTML = '';
  steps.forEach((_,i) => {
    const d = document.createElement('div');
    d.className = 'step-dot' + (i === currentStep ? ' active' : i < currentStep ? ' done' : '');
    dots.appendChild(d);
  });

  document.getElementById('btnPrev').disabled = currentStep === 0;

  const btnNext = document.getElementById('btnNext');
  if (currentStep === steps.length - 1) {
    btnNext.style.display = 'none';
  } else {
    btnNext.style.display = 'inline-flex';
    btnNext.innerHTML = 'Avanti <span class="btn-icon">→</span>';
  }

  // Init location selects if step 0
  if (currentStep === 0) { initLocationSelects(); restoreFields(); }
  else restoreFields();
}

function nextStep() {
  if (currentStep < steps.length - 1) {
    saveCurrentFields();
    currentStep++;
    renderCurrentStep();
    window.scrollTo({top:0,behavior:'smooth'});
  }
}

function prevStep() {
  if (currentStep > 0) {
    saveCurrentFields();
    currentStep--;
    renderCurrentStep();
    window.scrollTo({top:0,behavior:'smooth'});
  }
}

// ═══════════════════════════════════════════
// LOCATION SELECTS
// ═══════════════════════════════════════════
let _comuneIndex = null;
function _normComune(s){ return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,''); }
function buildComuneIndex(){
  if (_comuneIndex) return _comuneIndex;
  const idx = [];
  for (const reg in regioniData){
    for (const prov in regioniData[reg]){
      for (const com in regioniData[reg][prov]){
        idx.push({reg, prov, com, prezzo: regioniData[reg][prov][com], n: _normComune(com)});
      }
    }
  }
  _comuneIndex = idx;
  return idx;
}
function setupComuneSearch(regioneSelect, provinciaSelect, comuneSelect){
  const input = document.getElementById('comuneSearch');
  const box = document.getElementById('comuneSearchResults');
  if (!input || !box) return;
  let active = -1, current = [];
  function close(){ box.classList.remove('open'); box.innerHTML=''; active=-1; current=[]; }
  function pick(item){
    if (!item) return;
    regioneSelect.value = item.reg; regioneSelect.dispatchEvent(new Event('change'));
    provinciaSelect.value = item.prov; provinciaSelect.dispatchEvent(new Event('change'));
    comuneSelect.value = item.com; comuneSelect.dispatchEvent(new Event('change'));
    input.value = item.com;
    close();
  }
  function render(){
    if (!current.length){ box.innerHTML = '<div class="search-empty">Nessun comune trovato</div>'; box.classList.add('open'); return; }
    box.innerHTML = current.map((it,i)=>`
      <div class="search-item${i===active?' active':''}" data-i="${i}" role="option">
        <div class="si-main"><span class="si-c">${it.com}</span><span class="si-loc">${it.prov} · ${it.reg}</span></div>
        <span class="si-pz">${it.prezzo.toLocaleString('it-IT')} €/mq</span>
      </div>`).join('');
    box.classList.add('open');
    box.querySelectorAll('.search-item').forEach(el=>{
      el.addEventListener('mousedown', e=>{ e.preventDefault(); pick(current[+el.dataset.i]); });
    });
  }
  function search(q){
    const nq = _normComune(q.trim());
    if (nq.length < 2){ close(); return; }
    const idx = buildComuneIndex();
    const starts = [], contains = [];
    for (const it of idx){
      const p = it.n.indexOf(nq);
      if (p === 0){ if (starts.length < 8) starts.push(it); }
      else if (p > 0){ if (contains.length < 8) contains.push(it); }
    }
    current = starts.concat(contains).slice(0, 8);
    active = current.length ? 0 : -1;
    render();
  }
  input.addEventListener('input', ()=>search(input.value));
  input.addEventListener('focus', ()=>{ if (input.value.trim().length >= 2) search(input.value); });
  input.addEventListener('keydown', e=>{
    if (!box.classList.contains('open')) return;
    if (e.key === 'ArrowDown'){ e.preventDefault(); active = Math.min(active+1, current.length-1); render(); }
    else if (e.key === 'ArrowUp'){ e.preventDefault(); active = Math.max(active-1, 0); render(); }
    else if (e.key === 'Enter'){ e.preventDefault(); pick(current[active]); }
    else if (e.key === 'Escape'){ close(); }
  });
  document.addEventListener('click', e=>{ if (!e.target.closest('.comune-search-wrap')) close(); });
}
function initLocationSelects() {
  const regioneSelect = document.getElementById('regione');
  const provinciaSelect = document.getElementById('provincia');
  const comuneSelect = document.getElementById('comune');
  const prezzoInput = document.getElementById('prezzo_mq');
  if (!regioneSelect) return;

  function populateSelect(sel, vals, keepFirst) {
    const prev = sel.value;
    sel.innerHTML = keepFirst ? `<option value="">—</option>` : '';
    vals.forEach(v => {
      const o = document.createElement('option');
      o.value = v; o.textContent = v;
      sel.appendChild(o);
    });
    if (vals.includes(prev)) sel.value = prev;
  }

  populateSelect(regioneSelect, Object.keys(regioniData), false);

  // restore saved values
  if (savedRegione) regioneSelect.value = savedRegione;

  regioneSelect.addEventListener('change', () => {
    savedRegione = regioneSelect.value;
    const province = Object.keys(regioniData[regioneSelect.value] || {});
    populateSelect(provinciaSelect, province, true);
    if (savedProvincia && province.includes(savedProvincia)) {
      provinciaSelect.value = savedProvincia;
    }
    provinciaSelect.dispatchEvent(new Event('change'));
  });

  provinciaSelect.addEventListener('change', () => {
    savedProvincia = provinciaSelect.value;
    const comuni = Object.keys(regioniData[regioneSelect.value]?.[provinciaSelect.value] || {});
    populateSelect(comuneSelect, comuni, true);
    if (savedComune && comuni.includes(savedComune)) {
      comuneSelect.value = savedComune;
    }
    comuneSelect.dispatchEvent(new Event('change'));
  });

  comuneSelect.addEventListener('change', () => {
    savedComune = comuneSelect.value;
    const prezzo = regioniData[regioneSelect.value]?.[provinciaSelect.value]?.[comuneSelect.value];
    if (prezzo && prezzoInput) {
      prezzoInput.value = prezzo;
      savedPrezzoMq = prezzo;
    }
  });

  setupComuneSearch(regioneSelect, provinciaSelect, comuneSelect);
  if (savedRegione) {
    regioneSelect.dispatchEvent(new Event('change'));
  } else {
    regioneSelect.dispatchEvent(new Event('change'));
  }
}

// ═══════════════════════════════════════════
// STATE PERSISTENCE — salva TUTTI i campi
// ═══════════════════════════════════════════
let savedRegione = '', savedProvincia = '', savedComune = '', savedPrezzoMq = '';

// Dizionario globale: id → valore
const fieldState = {};

// Salva tutti i campi visibili nel dizionario
function saveCurrentFields() {
  document.querySelectorAll('#fieldsArea input, #fieldsArea select').forEach(el => {
    if (el.id) fieldState[el.id] = el.value;
  });
}

// Ripristina i valori dopo il render
function restoreFields() {
  Object.entries(fieldState).forEach(([id, val]) => {
    const el = document.getElementById(id);
    if (el && id !== 'regione' && id !== 'provincia' && id !== 'comune') {
      el.value = val;
    }
  });
}

// Helper to read a field value (legge dal DOM o dal dizionario)
function getVal(id) {
  const el = document.getElementById(id);
  if (el) return el.value;
  return fieldState[id] || '';
}
function isYes(id) { return getVal(id) === 'si'; }

// ═══════════════════════════════════════════
// CALCOLO
// ═══════════════════════════════════════════
function formatEuro(v) {
  return v.toLocaleString('it-IT',{style:'currency',currency:'EUR',maximumFractionDigits:0});
}

// Conteggio animato del valore finale (come l'app)
function animateValue(el, target){
  if (!el) return;
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce || !(target > 0)){ el.textContent = formatEuro(target || 0); return; }
  const dur = 1100, t0 = performance.now();
  const ease = p => 1 - Math.pow(2, -10 * p); // easeOutExpo
  let done = false;
  function frame(now){
    const p = Math.min((now - t0) / dur, 1);
    el.textContent = formatEuro(p < 1 ? target * ease(p) : target);
    if (p < 1) requestAnimationFrame(frame); else done = true;
  }
  requestAnimationFrame(frame);
  // rete di sicurezza: garantisce il valore finale anche se rAF e' sospeso (tab in background)
  setTimeout(function(){ if (!done) el.textContent = formatEuro(target); }, dur + 120);
}

// ── RESULT MODE (schermata risultato che sostituisce il wizard) ──
function buildResultSummary(){
  const el=document.getElementById('resultSummary'); if(!el) return;
  const superficie=getVal('superficie');
  const prezzo=getVal('prezzo_mq')||savedPrezzoMq;
  const rows=[];
  if(savedComune) rows.push(['Comune', savedComune+(savedProvincia?` (${savedProvincia})`:'')]);
  if(savedRegione) rows.push(['Regione', savedRegione]);
  if(superficie) rows.push(['Superficie', `${superficie} mq`]);
  if(prezzo) rows.push(['Prezzo al mq', `${Number(prezzo).toLocaleString('it-IT')} €/mq`]);
  el.innerHTML=rows.map(([k,v])=>`<div class="rs-row"><span class="rs-k">${k}</span><span class="rs-v">${v}</span></div>`).join('');
}
function enterResultMode(){
  const w=document.querySelector('.wizard'); if(w) w.classList.add('result-mode');
  window.scrollTo({top:0,behavior:'smooth'});
}
function modificaDati(){
  const w=document.querySelector('.wizard'); if(w) w.classList.remove('result-mode');
  const p=document.getElementById('resultPanel'); if(p) p.classList.remove('visible');
  renderCurrentStep();
  window.scrollTo({top:0,behavior:'smooth'});
}
function nuovaValutazione(){
  const w=document.querySelector('.wizard'); if(w) w.classList.remove('result-mode');
  const p=document.getElementById('resultPanel'); if(p) p.classList.remove('visible');
  for(const k in fieldState) delete fieldState[k];
  savedRegione=''; savedProvincia=''; savedComune=''; savedPrezzoMq='';
  currentStep=0;
  const btn=document.getElementById('btn-report'); if(btn) btn.style.display='none';
  const warn=document.getElementById('msg-pdf-warning'); if(warn){ warn.style.display='none'; warn.textContent=''; }
  renderCurrentStep();
  window.scrollTo({top:0,behavior:'smooth'});
}
function calcolaValore() {
  // Salva l'ultimo step prima di calcolare
  saveCurrentFields();
  let prezzoMq = parseFloat(getVal('prezzo_mq') || savedPrezzoMq);
  let superficie = parseFloat(getVal('superficie'));
  if (!prezzoMq || !superficie) {
    alert('Inserisci prezzo al mq e superficie per calcolare il valore.');
    return;
  }
  let valore = prezzoMq * superficie;

  valore += parseInt(getVal('posto_auto') || 0) * 18000;
  valore += parseInt(getVal('garage') || 0) * 30000;

  if (isYes('vista_mare')) valore *= 1.18; else valore *= 0.88;

  const stato = getVal('ristrutturare');
  if (stato === 'si') valore -= superficie * 1000;
  else if (stato === 'parzialmente') valore -= superficie * 500;

  let piano = parseInt(getVal('piano') || 0);
  if (piano >= 2 && !isYes('ascensore')) {
    valore -= 7000;
    if (piano >= 3) valore -= (piano - 2) * 4500;
  }
  if (isYes('semi_interrato')) valore -= 10000;
  if (isYes('attico_ascensore')) valore *= 1.10;
  if (!isYes('esposizione')) valore *= 1.03;
  if (isYes('vista_chiusa')) valore *= 0.82;

  const lum = getVal('luminosita');
  if (lum === 'poca') valore *= 0.95;
  if (lum === 'molta') valore *= 1.05;

  if (isYes('spazio_verde')) valore *= 1.06;
  if (isYes('finiture')) valore *= 1.05;
  if (isYes('doppi_servizi')) valore += 10000;
  if (isYes('cabina_armadio')) valore += 5000;
  if (isYes('camino')) valore += 3000;
  if (isYes('aria_condizionata')) valore += 4000;
  if (isYes('riscaldamento_pavimento')) valore += 6000;
  if (isYes('riscaldamento_autonomo')) valore *= 1.02;

  const classe = getVal('classe_energetica');
  const impattiClasse = {A:1.10,B:1.08,C:1.06,D:1.04,E:1.02,F:0.92,G:0.90};
  valore *= impattiClasse[classe] || 1;

  const tetto = getVal('tetto_facciata');
  const impattitetto = {entrambi:1.06,nessuno:1.00,solo_tetto:1.03,solo_facciata:1.03};
  valore *= impattitetto[tetto] || 1;

  const localita = getVal('localita');
  const impattilocalita = {residenziale:1.00,periferica:0.93,centrale:1.16,lusso:1.18};
  valore *= impattilocalita[localita] || 1;

  const terrazzo = getVal('terrazzo');
  if (terrazzo === '10') valore += 11000;
  else if (terrazzo === '20') valore += 18000;
  else if (terrazzo === 'oltre') valore += 25000;

  if (isYes('balcone')) valore += 4500;
  if (isYes('vista_panoramica')) valore *= 1.08;
  if (isYes('barbecue')) valore += 3000;
  if (isYes('cantina')) valore += 5000;
  if (isYes('zona_centrale')) valore *= 1.10;
  if (isYes('zona_rumorosa')) valore *= 0.90;
  if (isYes('vicinanza_spiaggia')) valore *= 1.05;
  if (isYes('vicinanza_trasporti')) valore *= 1.03;
  if (isYes('vicinanza_servizi')) valore *= 1.03;
  if (isYes('presenza_bnb')) valore *= 0.95;
  if (isYes('cappotto_termico')) valore += 6000;
  if (isYes('infissi_nuovi')) valore += (superficie / 20) * 4000;
  if (isYes('impianti_recenti')) valore += 8000;
  if (isYes('domotica')) valore *= 1.03;
  if (isYes('affitto_breve')) valore *= 1.04;
  if (isYes('antifurto')) valore += 4000;
  if (isYes('videocitofono')) valore += 2000;
  if (isYes('fotovoltaico')) valore *= 1.05;
  if (isYes('colonnina')) valore += 1500;
  if (isYes('spa_palestra')) valore *= 1.03;

  // Show result
  const panel = document.getElementById('resultPanel');
  animateValue(document.getElementById('risultato'), valore);
  const nome = fieldState['nome_proprieta'] || getVal('nome_proprieta') || '';
  document.getElementById('resultProperty').textContent = nome ? `${nome}` : '';
  panel.classList.add('visible');
  buildResultSummary();
  enterResultMode();

  // PDF / app handling
  if (!navigator.userAgent.toLowerCase().includes('median')) {
    const btn = document.getElementById('btn-report');
    btn.style.display = 'flex';
  } else {
    const warn = document.getElementById('msg-pdf-warning');
    if (!warn.textContent) {
      warn.textContent = 'Report PDF disponibile solo nella versione browser su quotamipro.it';
      warn.style.display = 'block';
    }
  }
}

// ═══════════════════════════════════════════
// REPORT PDF
// ═══════════════════════════════════════════
function scaricaReport() {
  const campi = [
    ['regione','Regione'],['provincia','Provincia'],['comune','Comune'],['prezzo_mq','Prezzo €/mq'],
    ['superficie','Superficie mq'],['localita','Tipologia Località'],['tetto_facciata','Facciata/Tetto'],
    ['cappotto_termico','Cappotto Termico'],['ristrutturare','Da Ristrutturare'],['impianti_recenti','Impianti Recenti'],
    ['fotovoltaico','Fotovoltaico'],['infissi_nuovi','Infissi Nuovi'],['classe_energetica','Classe Energetica'],
    ['riscaldamento_autonomo','Risc. Autonomo'],['riscaldamento_pavimento','Risc. Pavimento'],['camino','Camino/Stufa'],
    ['aria_condizionata','Aria Condizionata'],['posto_auto','Posti Auto'],['garage','Garage'],
    ['semi_interrato','Semi-Interrato'],['piano','Piano'],['ascensore','Ascensore'],['attico_ascensore','Attico+Ascensore'],
    ['vista_mare','Vista Mare/Montagna'],['terrazzo','Terrazzo'],['balcone','Balcone'],['vista_panoramica','Vista Panoramica'],
    ['esposizione','Esposizione Sud/Est'],['luminosita','Luminosità'],['vista_chiusa','Vista Chiusa'],
    ['spazio_verde','Spazio Verde'],['doppi_servizi','Doppi Servizi'],['finiture','Finiture Pregio'],
    ['cabina_armadio','Cabina Armadio'],['barbecue','Barbecue'],['cantina','Cantina/Soffitta'],
    ['zona_centrale','Zona Centrale'],['zona_rumorosa','Zona Rumorosa'],['vicinanza_spiaggia','Vicino Spiaggia'],
    ['vicinanza_trasporti','Vicino Trasporti'],['vicinanza_servizi','Vicino Servizi'],['presenza_bnb','B&B in Zona'],
    ['affitto_breve','Affitto Breve'],['spa_palestra','Spa/Palestra'],['domotica','Domotica'],
    ['antifurto','Antifurto'],['videocitofono','Videocitofono'],['colonnina','Colonnina EV']
  ];

  let blocchi = '';
  for (let i = 0; i < campi.length; i += 4) {
    const gruppo = campi.slice(i, i + 4);
    const celle = gruppo.map(([id, nome]) => {
      const el = document.getElementById(id);
      const val = el ? (el.tagName === 'SELECT' ? el.options[el.selectedIndex]?.text : (el.value || '—')) : '—';
      const bg = Math.floor(i/4) % 2 === 0 ? '#0f1110' : '#0a0b0a';
      return `<td style="width:25%;padding:7px 10px;border-right:1px solid rgba(56,242,60,.08);background:${bg}">
        <div style="font-size:9px;color:#a1a1aa;text-transform:uppercase;letter-spacing:.5px;margin-bottom:2px">${nome}</div>
        <div style="font-size:12px;font-weight:700;color:#fff">${val}</div>
      </td>`;
    }).join('');
    blocchi += `<tr>${celle}</tr>`;
  }

  const valoreText = document.getElementById('risultato').textContent;
  const data = new Date().toLocaleDateString('it-IT',{day:'2-digit',month:'short',year:'numeric'});
  const nome = fieldState['nome_proprieta'] || getVal('nome_proprieta') || '—';

  const html = `<!DOCTYPE html><html lang="it"><head><meta charset="UTF-8"><title>Report QuotaMi</title>
  <style>
    @media print{body{-webkit-print-color-adjust:exact;print-color-adjust:exact;margin:0}@page{margin:12mm}}
    *{margin:0;padding:0;box-sizing:border-box}
    body{background:#0a0b0a;color:#fff;font-family:'Segoe UI',Tahoma,sans-serif;padding:20px;font-size:12px}
    .header{display:flex;align-items:center;gap:12px;margin-bottom:16px;padding-bottom:12px;border-bottom:2px solid rgba(56,242,60,.3)}
    .logo-box{width:40px;height:40px;border-radius:10px;background:linear-gradient(145deg,rgba(56,242,60,.2),rgba(56,242,60,.05));border:2px solid rgba(56,242,60,.4);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:900;color:#38f23c}
    .brand h1{font-size:20px;font-weight:800}.brand h1 span{color:#38f23c}
    .brand p{color:#a1a1aa;font-size:11px;margin-top:2px}
    .date{margin-left:auto;text-align:right;color:#a1a1aa;font-size:10px}
    .date strong{display:block;color:#fff;font-size:12px}
    .value-box{background:linear-gradient(135deg,rgba(56,242,60,.18),rgba(56,242,60,.04));border:2px solid rgba(56,242,60,.4);border-radius:12px;padding:16px 24px;margin:14px 0;text-align:center}
    .value-label{font-size:10px;color:#a1a1aa;font-weight:600;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px}
    .value-num{font-size:32px;font-weight:900;color:#38f23c;letter-spacing:-1px}
    h2{font-size:11px;color:#a1a1aa;font-weight:700;margin:14px 0 8px;text-transform:uppercase;letter-spacing:1px;padding-bottom:4px;border-bottom:1px solid rgba(56,242,60,.15)}
    table{width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid rgba(56,242,60,.15)}
    .footer{margin-top:14px;text-align:center;color:#6b7280;font-size:9px;padding-top:10px;border-top:1px solid rgba(56,242,60,.1)}
    .footer strong{color:#38f23c}
  </style></head><body>
  <div class="header">
    <div class="logo-box">Q</div>
    <div class="brand"><h1><span>Quota</span>Mi</h1><p>Report Valutazione Immobiliare</p></div>
    <div class="date">Generato il<br><strong>${data}</strong></div>
  </div>
  <div style="text-align:center;margin:12px 0;padding:12px;border-radius:10px;border:1px solid rgba(56,242,60,.2);background:rgba(56,242,60,.04)">
    <div style="font-size:10px;color:#a1a1aa;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px">Riferimento Proprietà</div>
    <div style="font-size:18px;font-weight:800;color:#fff">${nome}</div>
  </div>
  <div class="value-box">
    <div class="value-label">Valore di Mercato Stimato</div>
    <div class="value-num">${valoreText}</div>
  </div>
  <h2>Caratteristiche Immobile</h2>
  <table>${blocchi}</table>
  <div class="footer"><strong>QuotaMi</strong> — Valutazione basata su 40+ parametri · quotami.it</div>
  </body></html>`;

  const w = window.open('','_blank');
  w.document.open();
  w.document.write(html);
  w.document.close();
  w.onload = () => { w.focus(); w.print(); };
}

