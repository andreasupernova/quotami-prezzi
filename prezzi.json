<!DOCTYPE html>
<html lang="it">
<head>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9433898657711555" crossorigin="anonymous"></script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>QuotaMi Pro — Valutazione Immobiliare</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --green: #38f23c;
  --green-dim: rgba(56,242,60,.15);
  --green-glow: rgba(56,242,60,.35);
  --bg: #080909;
  --surface: #0e100f;
  --surface2: #141614;
  --surface3: #1a1d1a;
  --border: rgba(255,255,255,.07);
  --border-green: rgba(56,242,60,.2);
  --text: #f0f0ee;
  --muted: #7a7d79;
  --muted2: #555854;
  --radius: 16px;
  --radius-sm: 10px;
  --transition: .22s cubic-bezier(.4,0,.2,1);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  font-family:'DM Sans',sans-serif;
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  line-height:1.5;
  overflow-x:hidden;
  -webkit-tap-highlight-color:transparent;
}

/* ── NOISE OVERLAY ── */
body::before{
  content:'';
  position:fixed;inset:0;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.035'/%3E%3C/svg%3E");
  pointer-events:none;z-index:0;opacity:.6;
}

/* ── AMBIENT LIGHTS ── */
.ambient{position:fixed;pointer-events:none;z-index:0;border-radius:50%;filter:blur(120px);opacity:.12}
.ambient-1{width:600px;height:400px;background:var(--green);top:-100px;right:-150px}
.ambient-2{width:500px;height:350px;background:#1a4d1c;bottom:-80px;left:-100px}

/* ── LAYOUT ── */
.page{position:relative;z-index:1;max-width:880px;margin:0 auto;padding:32px 20px 80px}

/* ── HEADER ── */
header{display:flex;align-items:center;justify-content:space-between;margin-bottom:48px;padding-bottom:24px;border-bottom:1px solid var(--border)}
.logo-wrap{display:flex;align-items:center;gap:16px}
.logo-mark{
  width:52px;height:52px;border-radius:14px;
  background:#000;
  border:1px solid var(--border-green);
  display:grid;place-items:center;
  overflow:hidden;
  box-shadow:0 0 24px rgba(56,242,60,.12),inset 0 1px 0 rgba(255,255,255,.06);
}
.logo-text h1{
  font-family:'DM Serif Display',serif;
  font-size:22px;letter-spacing:-.3px;color:var(--text);
  line-height:1.1;
}
.logo-text h1 em{color:var(--green);font-style:normal}
.logo-text p{font-size:12px;color:var(--muted);margin-top:2px;font-weight:300;letter-spacing:.3px}
.header-badge{
  font-size:11px;font-weight:500;color:var(--green);
  background:var(--green-dim);border:1px solid var(--border-green);
  padding:5px 12px;border-radius:20px;letter-spacing:.4px;
}

/* ── WIZARD CONTAINER ── */
.wizard{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:20px;
  overflow:hidden;
  box-shadow:0 24px 64px rgba(0,0,0,.5);
}

/* ── PROGRESS BAR ── */
.progress-header{
  padding:20px 28px 0;
  background:var(--surface);
}
.step-counter{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:12px;
}
.step-label{font-size:12px;color:var(--muted);font-weight:500;letter-spacing:.3px}
.step-fraction{font-size:12px;color:var(--green);font-weight:600}
.progress-track{
  height:3px;background:var(--surface3);border-radius:2px;overflow:hidden;margin-bottom:0;
}
.progress-fill{
  height:100%;background:linear-gradient(90deg,rgba(56,242,60,.6),var(--green));
  border-radius:2px;transition:width .4s cubic-bezier(.4,0,.2,1);
  box-shadow:0 0 8px rgba(56,242,60,.4);
}

/* ── STEP TITLE ── */
.step-title-bar{
  padding:20px 28px 16px;
  border-bottom:1px solid var(--border);
}
.step-title-bar h2{
  font-family:'DM Serif Display',serif;
  font-size:20px;color:var(--text);letter-spacing:-.2px;
}
.step-title-bar p{font-size:13px;color:var(--muted);margin-top:4px;font-weight:300}

/* ── FIELDS GRID ── */
.fields-area{
  padding:24px 28px;
  display:grid;gap:16px;
  animation:fadeSlide .3s ease forwards;
}
@keyframes fadeSlide{
  from{opacity:0;transform:translateY(8px)}
  to{opacity:1;transform:translateY(0)}
}
.fields-area.slide-out{
  animation:slideOut .25s ease forwards;
}
@keyframes slideOut{
  from{opacity:1;transform:translateX(0)}
  to{opacity:0;transform:translateX(-20px)}
}

/* ── FIELD GROUP ── */
.field-group{display:flex;flex-direction:column;gap:7px}
label{
  font-size:12px;font-weight:500;color:var(--muted);
  text-transform:uppercase;letter-spacing:.5px;
}
.field-control{
  position:relative;
  display:flex;align-items:center;
  background:var(--surface2);
  border:1px solid var(--border);
  border-radius:var(--radius-sm);
  transition:border-color var(--transition),box-shadow var(--transition);
  overflow:hidden;
  height:46px;
  min-height:46px;
}
.field-control:focus-within{
  border-color:rgba(56,242,60,.4);
  box-shadow:0 0 0 4px rgba(56,242,60,.08);
}
.field-control input,
.field-control select{
  flex:1;background:transparent;border:0;outline:0;
  color:var(--text);font-family:'DM Sans',sans-serif;
  font-size:14px;font-weight:400;
  padding:0 14px;cursor:pointer;
  appearance:none;-webkit-appearance:none;
  height:100%;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.field-control select{
  background-image:url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 6L11 1' stroke='%237a7d79' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E");
  background-repeat:no-repeat;
  background-position:right 14px center;
  padding-right:36px;
}
.field-control select option{background:#141614;color:var(--text)}
.field-control input::placeholder{color:var(--muted2)}
.field-control input[type=number]::-webkit-inner-spin-button{opacity:.3}

/* ── SPECIAL: FULL WIDTH FIELD ── */
.field-full{grid-column:1 / -1}

/* ── LOCATION FIELDS ── */
.location-grid{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:12px;
}

/* ── STEP GRID LAYOUTS ── */
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}

/* ══════════════════════════════════════
   MOBILE OPTIMIZATION — ≤ 640px
══════════════════════════════════════ */
@media(max-width:640px){

  /* Layout */
  .page{padding:16px 12px 60px}

  /* Header */
  header{
    margin-bottom:24px;
    padding-bottom:16px;
    flex-wrap:wrap;
    gap:10px;
  }
  .logo-mark{width:42px;height:42px;border-radius:12px}
  .logo-text h1{font-size:18px}
  .logo-text p{font-size:11px}
  .header-badge{font-size:10px;padding:4px 10px}

  /* Progress */
  .progress-header{padding:14px 16px 0}
  .step-label{font-size:11px}
  .step-fraction{font-size:11px}

  /* Step title */
  .step-title-bar{padding:14px 16px 12px}
  .step-title-bar h2{font-size:17px}
  .step-title-bar p{font-size:12px}

  /* Fields area */
  .fields-area{padding:16px}

  /* Grids: tutto a colonna singola */
  .grid-3{grid-template-columns:1fr;gap:12px}
  .grid-2{grid-template-columns:1fr;gap:12px}
  .location-grid{grid-template-columns:1fr;gap:10px}

  /* Labels */
  label{font-size:11px;letter-spacing:.3px}

  /* Field controls */
  .field-control{height:50px;min-height:50px;border-radius:10px}
  .field-control input,
  .field-control select{font-size:16px;padding:0 12px} /* 16px evita zoom iOS */

  /* Hero input */
  .hero-input{font-size:16px;padding:14px 12px;border-radius:10px}

  /* Nav bar */
  .nav-bar{padding:12px 16px;gap:8px;flex-wrap:nowrap}
  .nav-bar > div{gap:8px}
  .btn{padding:12px 14px;font-size:13px;gap:6px;white-space:nowrap}
  .btn-icon{font-size:14px}
  .step-dots{gap:4px;flex-shrink:1;min-width:0;overflow:hidden}
  .step-dot{width:5px;height:5px;flex-shrink:0}

  /* Result panel */
  .result-panel{margin:0 16px 16px;padding:18px 16px}
  .result-value{font-size:34px;letter-spacing:-1px}
  .result-label{font-size:10px}
  .result-property{font-size:12px}

  /* PDF elements */
  #msg-pdf-warning{margin:0 16px 16px;font-size:12px;padding:12px}
  #btn-report{width:calc(100% - 32px);margin:0 16px 16px;font-size:13px;padding:13px}

  /* Wizard border radius */
  .wizard{border-radius:16px;overflow:hidden}

  /* Prevent any horizontal overflow */
  .wizard *{max-width:100%}
}

/* ── DIVIDER LABEL ── */
.section-divider{
  font-size:11px;font-weight:600;color:var(--muted);
  text-transform:uppercase;letter-spacing:.8px;
  padding:0 0 12px;
  border-bottom:1px solid var(--border);
  margin-bottom:4px;
  grid-column:1 / -1;
  display:flex;align-items:center;gap:10px;
}
.section-divider::after{content:'';flex:1;height:1px;background:var(--border)}

/* ── NAVIGATION ── */
.nav-bar{
  display:flex;align-items:center;justify-content:space-between;
  padding:20px 28px;
  border-top:1px solid var(--border);
  background:var(--surface);
}
.btn{
  display:inline-flex;align-items:center;gap:8px;
  padding:12px 24px;border-radius:var(--radius-sm);
  font-family:'DM Sans',sans-serif;font-size:14px;font-weight:600;
  cursor:pointer;border:none;transition:all var(--transition);
  letter-spacing:.1px;
  touch-action:manipulation;
  -webkit-user-select:none;user-select:none;
}
.btn-primary{
  background:var(--green);color:#000;
  box-shadow:0 4px 16px rgba(56,242,60,.25);
}
.btn-primary:hover{filter:brightness(1.08);box-shadow:0 6px 24px rgba(56,242,60,.35)}
.btn-primary:active{transform:translateY(1px)}
.btn-ghost{
  background:transparent;color:var(--muted);
  border:1px solid var(--border);
}
.btn-ghost:hover{color:var(--text);border-color:rgba(255,255,255,.15)}
.btn-ghost:disabled{opacity:.3;cursor:not-allowed}
.btn-icon{font-size:16px;line-height:1}

/* ── RESULT PANEL ── */
.result-panel{
  margin:0 28px 28px;
  background:linear-gradient(135deg,rgba(56,242,60,.1),rgba(56,242,60,.03));
  border:1px solid rgba(56,242,60,.25);
  border-radius:var(--radius);
  padding:24px 28px;
  display:none;
  animation:fadeSlide .4s ease forwards;
}
.result-panel.visible{display:block}
.result-label{
  font-size:11px;font-weight:600;color:var(--green);
  text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;
  display:flex;align-items:center;gap:8px;
}
.result-label::before{content:'●';font-size:8px;opacity:.7}
.result-value{
  font-family:'DM Serif Display',serif;
  font-size:52px;color:var(--green);letter-spacing:-1.5px;line-height:1;
  text-shadow:0 0 30px rgba(56,242,60,.32), 0 0 6px rgba(56,242,60,.22);
  animation:valuePop .55s cubic-bezier(.2,.7,.2,1) both;
}
@keyframes valuePop{from{transform:scale(.94);opacity:.35}to{transform:scale(1);opacity:1}}
.result-property{
  font-size:13px;color:var(--muted);margin-top:8px;font-weight:300;
}

/* ── PDF MSG ── */
#msg-pdf-warning{
  margin:0 28px 20px;
  padding:14px;border-radius:var(--radius-sm);
  border:1px solid rgba(56,242,60,.2);
  background:rgba(56,242,60,.04);
  color:var(--muted);text-align:center;
  font-size:13px;font-weight:500;
}

/* ── PDF BUTTON ── */
#btn-report{
  display:none;width:calc(100% - 56px);margin:0 28px 28px;
  padding:14px;border-radius:var(--radius-sm);
  border:1px solid rgba(56,242,60,.3);
  background:transparent;color:var(--green);
  font-family:'DM Sans',sans-serif;font-size:14px;font-weight:600;
  cursor:pointer;letter-spacing:.3px;
  transition:all var(--transition);
  display:flex;align-items:center;justify-content:center;gap:8px;
}
#btn-report:hover{background:rgba(56,242,60,.08);border-color:rgba(56,242,60,.5)}

/* ── NOME PROPERTY (step 0) ── */
.hero-input{
  background:var(--surface2);
  border:1px solid var(--border);
  border-radius:var(--radius-sm);
  padding:14px 16px;
  font-family:'DM Sans',sans-serif;
  font-size:15px;color:var(--text);
  outline:none;width:100%;
  transition:border-color var(--transition),box-shadow var(--transition);
}
.hero-input:focus{
  border-color:rgba(56,242,60,.4);
  box-shadow:0 0 0 4px rgba(56,242,60,.08);
}
.hero-input::placeholder{color:var(--muted2)}

/* ── STEP INDICATORS (dots) ── */
.step-dots{
  display:flex;align-items:center;gap:6px;
}
.step-dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--surface3);
  transition:all var(--transition);
}
.step-dot.active{background:var(--green);box-shadow:0 0 6px rgba(56,242,60,.5)}
.step-dot.done{background:rgba(56,242,60,.4)}

/* ── COMUNE SEARCH (come app) ── */
.comune-search-wrap .field-control{cursor:text}
.search-ico{flex:none;margin-left:14px;opacity:.9}
.comune-search-wrap .field-control input{padding-left:10px;cursor:text}
.search-results{
  position:absolute;top:100%;left:0;right:0;z-index:40;margin-top:6px;
  background:var(--surface3);border:1px solid var(--border);
  border-radius:var(--radius-sm);max-height:300px;overflow:auto;display:none;
  box-shadow:0 16px 44px rgba(0,0,0,.55);
}
.search-results.open{display:block}
.search-item{
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  padding:11px 14px;cursor:pointer;border-bottom:1px solid var(--border);
}
.search-item:last-child{border-bottom:0}
.search-item:hover,.search-item.active{background:var(--green-dim)}
.search-item .si-main{display:flex;flex-direction:column;gap:2px;min-width:0}
.search-item .si-c{color:var(--text);font-weight:600;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.search-item .si-loc{color:var(--muted);font-size:11.5px}
.search-item .si-pz{color:var(--green);font-size:12px;font-weight:600;white-space:nowrap}
.search-empty{padding:14px;color:var(--muted);font-size:13px;text-align:center}
.or-sep{display:flex;align-items:center;gap:12px;margin:16px 0 8px}
.or-sep::before,.or-sep::after{content:'';flex:1;height:1px;background:var(--border)}
.or-sep span{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;white-space:nowrap}

/* ── RESULT MODE: schermata risultato che sostituisce il wizard (come app) ── */
.wizard.result-mode .progress-header,
.wizard.result-mode .step-title-bar,
.wizard.result-mode .fields-area,
.wizard.result-mode .nav-bar{ display:none !important; }
.wizard.result-mode .result-panel{ text-align:center; padding:26px 8px 6px; }
.wizard.result-mode .result-label{ justify-content:center; }
.wizard.result-mode .result-property{ text-align:center; }
.result-summary{ display:none; }
.wizard.result-mode .result-summary{
  display:block; margin:22px 0 6px;
  background:var(--surface2); border:1px solid var(--border);
  border-radius:var(--radius-sm); overflow:hidden;
}
.result-summary .rs-row{
  display:flex; align-items:center; justify-content:space-between; gap:12px;
  padding:12px 16px; border-bottom:1px solid var(--border);
}
.result-summary .rs-row:last-child{ border-bottom:0; }
.result-summary .rs-k{ color:var(--muted); font-size:12.5px; }
.result-summary .rs-v{ color:var(--text); font-size:14px; font-weight:600; text-align:right; }
.result-disclaimer{ display:none; }
.wizard.result-mode .result-disclaimer{
  display:block; margin-top:14px; color:var(--muted2);
  font-size:11.5px; line-height:1.55; text-align:center; padding:0 8px;
}
.result-actions{ display:none; }
.wizard.result-mode .result-actions{ display:flex; flex-direction:column; gap:10px; margin-top:14px; }
.result-actions .btn{ width:100%; justify-content:center; }
.btn-text{
  background:transparent; border:0; color:var(--muted);
  font-family:'DM Sans',sans-serif; font-size:14px; padding:10px; cursor:pointer;
  transition:color var(--transition);
}
.btn-text:hover{ color:var(--text); }
</style>
</head>
<body>

<div class="ambient ambient-1"></div>
<div class="ambient ambient-2"></div>

<div class="page">
  <header>
    <div class="logo-wrap">
      <div class="logo-mark"><img src="data:image/png;base64," alt="QuotaMI" style="width:100%;height:100%;object-fit:contain;mix-blend-mode:screen;"></div>
      <div class="logo-text">
        <h1><em>Quota</em>Mi Pro</h1>
        <p>Valutazione Immobiliare Avanzata</p>
      </div>
    </div>
    <span class="header-badge">40+ Parametri</span>
  </header>

  <div class="wizard">
    <!-- PROGRESS -->
    <div class="progress-header">
      <div class="step-counter">
        <span class="step-label" id="stepLabel">Proprietà</span>
        <span class="step-fraction" id="stepFraction">1 / 14</span>
      </div>
      <div class="progress-track">
        <div class="progress-fill" id="progressFill" style="width:7%"></div>
      </div>
    </div>

    <!-- STEP TITLE -->
    <div class="step-title-bar">
      <h2 id="stepTitle">Inserisci i dati della proprietà</h2>
      <p id="stepSubtitle">Inizia con le informazioni di base sull'immobile</p>
    </div>

    <!-- DYNAMIC FIELDS -->
    <div class="fields-area" id="fieldsArea">
      <!-- populated by JS -->
    </div>

    <!-- RESULT PANEL -->
    <div class="result-panel" id="resultPanel">
      <div class="result-label">Valore di Mercato Stimato</div>
      <div class="result-value" id="risultato">—</div>
      <div class="result-property" id="resultProperty"></div>
    </div>

    <!-- RIEPILOGO (result mode) -->
    <div class="result-summary" id="resultSummary"></div>
    <div class="result-disclaimer">Stima automatizzata basata sui dati inseriti. Non sostituisce una perizia immobiliare professionale.</div>

    <!-- PDF MSG placeholder -->
    <div id="msg-pdf-warning" style="display:none"></div>

    <!-- PDF BUTTON -->
    <button id="btn-report" onclick="scaricaReport()" style="display:none">
      <span>⬇</span> Scarica Report PDF
    </button>

    <!-- AZIONI (result mode) -->
    <div class="result-actions" id="resultActions">
      <button class="btn btn-ghost" onclick="modificaDati()"><span class="btn-icon">←</span> Modifica dati</button>
      <button class="btn-text" onclick="nuovaValutazione()">Inizia una nuova valutazione</button>
    </div>

    <!-- NAV -->
    <div class="nav-bar">
      <div class="step-dots" id="stepDots"></div>
      <div style="display:flex;gap:10px">
        <button class="btn btn-ghost" id="btnPrev" onclick="prevStep()" disabled>
          <span class="btn-icon">←</span> Indietro
        </button>
        <button class="btn btn-primary" id="btnNext" onclick="nextStep()">
          Avanti <span class="btn-icon">→</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
// ═══════════════════════════════════════════
// DATI COMUNI (condensed — same data as original)
// ═══════════════════════════════════════════
const regioniData = {"Piemonte": {"Torino": {"Torino": 2267,
"Agliè": 720,
"Airasca": 1117,
"Ala di Stura": 558,
"Albiano d'Ivrea": 725,
"Almese": 1365,
"Alpette": 419,
"Alpignano": 1633,
"Andezeno": 1219,
"Andrate": 505,
"Angrogna": 453,
"Arignano": 1057,
"Avigliana": 1575,
"Azeglio": 365,
"Bairo": 523,
"Balangero": 839,
"Baldissero Canavese": 398,
"Baldissero Torinese": 1226,
"Balme": 527,
"Banchette": 858,
"Barbania": 646,
"Bardonecchia": 3251,
"Barone Canavese": 473,
"Beinasco": 1666,
"Bibiana": 757,
"Bobbio Pellice": 513,
"Bollengo": 681,
"Borgaro Torinese": 1775,
"Borgiallo": 522,
"Borgofranco d'Ivrea": 664,
"Borgomasino": 405,
"Borgone Susa": 711,
"Bosconero": 944,
"Brandizzo": 1463,
"Bricherasio": 1135,
